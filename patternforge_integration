import bpy
import os
import zipfile
from pathlib import Path


def log(msg):
    print(f"[PatternForge] {msg}")


# ---------- UV ----------
def ensure_uv(obj):
    if obj.type != 'MESH':
        return

    mesh = obj.data
    if not mesh.uv_layers:
        bpy.context.view_layer.objects.active = obj
        bpy.ops.object.select_all(action='DESELECT')
        obj.select_set(True)

        bpy.ops.object.mode_set(mode='EDIT')
        bpy.ops.mesh.select_all(action='SELECT')
        bpy.ops.uv.smart_project()
        bpy.ops.object.mode_set(mode='OBJECT')

        log("UV created")


# ---------- IMAGE LOAD ----------
def load_image(path):
    try:
        img = bpy.data.images.load(filepath=path)
        img.pack()
        return img
    except Exception as e:
        log(f"Failed to load {path}: {e}")
        return None


# ---------- MATERIAL ----------
def setup_pbr_material(mat, textures):
    mat.use_nodes = True
    nodes = mat.node_tree.nodes
    links = mat.node_tree.links
    nodes.clear()

    output = nodes.new("ShaderNodeOutputMaterial")
    principled = nodes.new("ShaderNodeBsdfPrincipled")

    output.location = (600, 0)
    principled.location = (300, 0)

    links.new(principled.outputs["BSDF"], output.inputs["Surface"])

    tex_coord = nodes.new("ShaderNodeTexCoord")
    tex_coord.location = (-800, 0)

    def create_tex_node(img, label, y):
        node = nodes.new("ShaderNodeTexImage")
        node.image = img
        node.label = label
        node.location = (-400, y)
        links.new(tex_coord.outputs["UV"], node.inputs["Vector"])
        return node

    y = 400

    # BaseColor
    if textures.get("basecolor"):
        img = load_image(textures["basecolor"])
        if img:
            node = create_tex_node(img, "BaseColor", y)
            links.new(node.outputs["Color"], principled.inputs["Base Color"])
            y -= 250

    # Roughness
    if textures.get("roughness"):
        img = load_image(textures["roughness"])
        if img:
            node = create_tex_node(img, "Roughness", y)
            node.image.colorspace_settings.name = 'Non-Color'
            links.new(node.outputs["Color"], principled.inputs["Roughness"])
            y -= 250

    # Metallic
    if textures.get("metallic"):
        img = load_image(textures["metallic"])
        if img:
            node = create_tex_node(img, "Metallic", y)
            node.image.colorspace_settings.name = 'Non-Color'
            links.new(node.outputs["Color"], principled.inputs["Metallic"])
            y -= 250

    # Normal
    if textures.get("normal"):
        img = load_image(textures["normal"])
        if img:
            tex = create_tex_node(img, "Normal", y)
            tex.image.colorspace_settings.name = 'Non-Color'

            normal = nodes.new("ShaderNodeNormalMap")
            normal.location = (-200, y)

            links.new(tex.outputs["Color"], normal.inputs["Color"])
            links.new(normal.outputs["Normal"], principled.inputs["Normal"])
            y -= 250

    # AO (multiply with basecolor)
    if textures.get("ao") and textures.get("basecolor"):
        ao_img = load_image(textures["ao"])
        base_img = load_image(textures["basecolor"])

        if ao_img and base_img:
            ao_node = create_tex_node(ao_img, "AO", y)
            base_node = create_tex_node(base_img, "BaseColor_AO", y + 200)

            mix = nodes.new("ShaderNodeMixRGB")
            mix.blend_type = 'MULTIPLY'
            mix.location = (-100, y)

            links.new(base_node.outputs["Color"], mix.inputs[1])
            links.new(ao_node.outputs["Color"], mix.inputs[2])
            links.new(mix.outputs["Color"], principled.inputs["Base Color"])

    # Height (Bump)
    if textures.get("height"):
        img = load_image(textures["height"])
        if img:
            tex = create_tex_node(img, "Height", y)
            tex.image.colorspace_settings.name = 'Non-Color'

            bump = nodes.new("ShaderNodeBump")
            bump.location = (-200, y)

            links.new(tex.outputs["Color"], bump.inputs["Height"])
            links.new(bump.outputs["Normal"], principled.inputs["Normal"])

    return mat


# ---------- ZIP ----------
def find_texture(name):
    return any(x in name for x in name)


def import_zip(zip_path, context):
    if not zipfile.is_zipfile(zip_path):
        raise ValueError("Not a ZIP file")

    extract_dir = os.path.join(os.path.dirname(zip_path), "patternforge_textures")
    os.makedirs(extract_dir, exist_ok=True)

    with zipfile.ZipFile(zip_path, 'r') as zf:
        zf.extractall(extract_dir)

    textures = {
        "basecolor": None,
        "roughness": None,
        "normal": None,
        "metallic": None,
        "ao": None,
        "height": None
    }

    for root, _, files in os.walk(extract_dir):
        for f in files:
            path = os.path.join(root, f)
            name = f.lower()

            if any(x in name for x in ["basecolor", "albedo", "diffuse"]):
                textures["basecolor"] = path
            elif "roughness" in name:
                textures["roughness"] = path
            elif "normal" in name:
                textures["normal"] = path
            elif "metallic" in name:
                textures["metallic"] = path
            elif "ao" in name:
                textures["ao"] = path
            elif "height" in name or "displacement" in name:
                textures["height"] = path

    obj = context.active_object
    if not obj or obj.type != 'MESH':
        bpy.ops.mesh.primitive_cube_add()
        obj = context.active_object

    ensure_uv(obj)

    mat = bpy.data.materials.new(name=Path(zip_path).stem)
    setup_pbr_material(mat, textures)

    if obj.data.materials:
        obj.data.materials[0] = mat
    else:
        obj.data.materials.append(mat)

    bpy.context.scene.world.use_nodes = True

    return obj


# ---------- UI ----------
class PF_OT_import(bpy.types.Operator):
    bl_idname = "patternforge.import"
    bl_label = "Import ZIP"

    filepath: bpy.props.StringProperty(subtype="FILE_PATH")

    def execute(self, context):
        try:
            obj = import_zip(self.filepath, context)
            self.report({'INFO'}, f"Done: {obj.name}")
        except Exception as e:
            self.report({'ERROR'}, str(e))
        return {'FINISHED'}

    def invoke(self, context, event):
        context.window_manager.fileselect_add(self)
        return {'RUNNING_MODAL'}


class PF_PT_panel(bpy.types.Panel):
    bl_label = "PatternForge"
    bl_idname = "PF_PT_panel"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "PatternForge"

    def draw(self, context):
        self.layout.operator("patternforge.import")


# ---------- REGISTER ----------
def register():
    bpy.utils.register_class(PF_OT_import)
    bpy.utils.register_class(PF_PT_panel)


def unregister():
    bpy.utils.unregister_class(PF_OT_import)
    bpy.utils.unregister_class(PF_PT_panel)


if __name__ == "__main__":
    register()
